{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Debug"
            ],
            "options": {
                "env": {
                    "PATH": "${env:CUBE_BUNDLE_PATH}/gnu-tools-for-stm32/14.3.1+st.2/bin;${env:CUBE_BUNDLE_PATH}/ninja/1.13.2+st.1/bin;${env:PATH}"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build (Release)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Release"
            ],
            "options": {
                "env": {
                    "PATH": "${env:CUBE_BUNDLE_PATH}/gnu-tools-for-stm32/14.3.1+st.2/bin;${env:CUBE_BUNDLE_PATH}/ninja/1.13.2+st.1/bin;${env:PATH}"
                }
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Debug",
                "--target",
                "clean"
            ],
            "problemMatcher": []
        },
        {
            "label": "Flash (Debug)",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/tools/flash.sh"
            ],
            "dependsOn": "Build (Debug)",
            "problemMatcher": []
        }
    ]
}
